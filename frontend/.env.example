# Variables à renseigner dans Vercel (Project Settings → Environment Variables)
# pour le déploiement du frontend Imperial Collection.
#
# NEXT_PUBLIC_API_URL : URL publique de l'API Django déployée sur Render
# (aucune distinction serveur/navigateur nécessaire ici, contrairement au
# développement local sous Docker — voir frontend/.env.local.example — car
# Vercel et Render communiquent tous deux via l'URL publique HTTPS).
NEXT_PUBLIC_API_URL=https://imperial-backend-iwu8.onrender.com/api

# Nom affiché dans les titres de page, le header, le footer, etc.
NEXT_PUBLIC_SITE_NAME="Imperial Collection"

# Numéro WhatsApp officiel du service client (format international, sans "+" ni espaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=237696000388
