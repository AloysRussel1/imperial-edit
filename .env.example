# ==== Django Core ====
DJANGO_SETTINGS_MODULE=core.settings.local
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ==== Database (PostgreSQL) ====
POSTGRES_DB=imperial_edit
POSTGRES_USER=imperial_edit
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://imperial_edit:changeme@db:5432/imperial_edit

# ==== Redis / Celery ====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==== JWT ====
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ==== Stock reservation ====
STOCK_RESERVATION_TIMEOUT_MINUTES=30

# ==== Media storage: LOCAL (dev filesystem) / CLOUDINARY / S3 ====
MEDIA_STORAGE_BACKEND=local

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS S3 (alternative)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-3

# ==== Payments: Mobile Money aggregators (Cameroun) ====
# CinetPay — laisser vide tant qu'aucun compte marchand réel n'est configuré :
# le backend bascule alors automatiquement sur le mode "sandbox" (paiement
# simulé, cf. apps/payments/gateways.py::SandboxGateway) pour que le tunnel
# d'achat reste testable de bout en bout sans dépendance externe.
# Créer un compte sur https://cinetpay.com puis récupérer API_KEY / SITE_ID /
# SECRET_KEY depuis le tableau de bord marchand > Intégration.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_NOTIFY_URL=https://api.imperialedit.com/api/payments/cinetpay-notify/
CINETPAY_RETURN_URL=https://imperialedit.com/checkout/return

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_WEBHOOK_URL=https://api.imperialedit.com/api/payments/webhooks/flutterwave/

# ==== Currency ====
DEFAULT_CURRENCY=XAF
SECONDARY_CURRENCY=EUR
EUR_XAF_RATE=655.957

# ==== WhatsApp click-to-chat ====
WHATSAPP_ADMIN_PHONE_NUMBER=237696000388

# ==== Notifications WhatsApp (API Cloud Meta) ====
# Vides par défaut : notifications journalisées sans appel réseau (apps.notifications).
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ==== E-mail transactionnel (production uniquement — en local, la config
# console de core/settings/local.py prend le dessus et affiche les e-mails
# dans les logs du conteneur) ====
# Compatible avec n'importe quel relais SMTP standard :
#   - Resend  : EMAIL_HOST=smtp.resend.com          EMAIL_HOST_USER=resend
#   - Brevo   : EMAIL_HOST=smtp-relay.brevo.com     EMAIL_HOST_USER=<identifiant Brevo>
# (EMAIL_HOST_PASSWORD = la clé API SMTP fournie par le service dans les deux cas)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Imperial Collection <notifications@imperialcollection.com>

# ==== Brevo (API transactionnelle — code OTP de vérification d'e-mail) ====
# Distinct du relais SMTP ci-dessus : appel direct à l'API HTTP v3 de Brevo
# (https://api.brevo.com/v3/smtp/email). Laisser vide en développement : le
# code est alors simplement journalisé (apps.notifications), pas envoyé.
# Créer une clé sur https://app.brevo.com > Paramètres SMTP & API > Clés API.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notifications@imperialcollection.com
BREVO_SENDER_NAME=Imperial Collection

# ==== Frontend (Next.js) ====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
INTERNAL_API_BASE_URL=http://web:8000/api
NEXT_PUBLIC_SITE_NAME="The Imperial Collection"
# Numéro WhatsApp officiel du service client (format international, sans "+" ni espaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=237696000388

# URL du frontend utilisée par le backend pour construire les liens de
# réinitialisation de mot de passe envoyés par e-mail.
FRONTEND_URL=http://localhost:3000
